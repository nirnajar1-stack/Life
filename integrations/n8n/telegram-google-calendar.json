    {
      "id": "88224221-3a09-4af3-88fc-7aaac85efa6c",
      "name": "Wrap Transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -140
      ],
      "parameters": {
        "jsCode": "\nconst tg = $('Telegram Trigger').first().json;\nconst msg = tg.message || {};\nconst text = String($input.first().json.text || '').trim();\nif (!text) {\n  return [{\n    json: {\n      message: {\n        text: '',\n        chat: msg.chat,\n        message_id: msg.message_id,\n      },\n      _emptyTranscript: true,\n    },\n  }];\n}\nreturn [{\n  json: {\n    message: {\n      text,\n      chat: msg.chat,\n      message_id: msg.message_id,\n    },\n    transcribed: true,\n  },\n}];\n"
      }
    },
    {
      "id": "e563f93a-c245-490c-9c95-743ff31a5ac5",
      "name": "Normalize Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        160
      ],
      "parameters": {
        "jsCode": "\nconst tg = $input.first().json;\nconst msg = tg.message || {};\nreturn [{\n  json: {\n    message: {\n      text: msg.text || '',\n      chat: msg.chat,\n      message_id: msg.message_id,\n    },\n    transcribed: false,\n  },\n}];\n"
      }
    },
    {
      "id": "b0f4f9d7-12ff-4bee-b204-370cbe7e95a6",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        0
      ],
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst text = String(item.message?.text || item.text || '').trim();\nconst tg = $('Telegram Trigger').first().json.message || {};\nif (!text) {\n  return [{\n    json: {\n      message: { text: '', chat: tg.chat, message_id: tg.message_id },\n      empty: true,\n    },\n  }];\n}\nreturn [{\n  json: {\n    message: {\n      text,\n      chat: item.message?.chat || tg.chat,\n      message_id: item.message?.message_id || tg.message_id,\n    },\n    empty: false,\n    transcribed: Boolean(item.transcribed),\n  },\n}];\n"
      }
