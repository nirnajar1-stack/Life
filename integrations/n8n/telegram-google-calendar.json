    {
      "id": "0e836991-59b4-4499-bb70-488005816c9f",
      "name": "AI Extract Event",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1720,
        -80
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=אתה מנתח הודעות טלגרם (טקסט או תמלול קולי) לאירועי יומן בעברית/אנגלית.\nהתאריך והשעה עכשיו (ישראל): {{ $now.setZone('Asia/Jerusalem').toFormat(\"yyyy-MM-dd'T'HH:mm:ssZZ\") }}.\n\nהחזר אך ורק אובייקט JSON אחד תקין, בלי טקסט נלווה ובלי ```.\n\nמבנה:\n{\n  \"title\": \"כותרת קצרה של האירוע\",\n  \"startsAt\": \"YYYY-MM-ddTHH:mm:ss+03:00\",\n  \"durationMinutes\": 60,\n  \"hourMentioned\": true,\n  \"durationMentioned\": false,\n  \"rawHour\": 6,\n  \"timeOfDayHint\": \"evening\",\n  \"confidence\": 0.9,\n  \"error\": null\n}\n\nכללים:\n1. title — נושא האירוע בלבד (בלי תאריך/שעה), עד 120 תווים. אם חסר: \"אירוע\".\n2. startsAt — תאריך+שעה באיזור ישראל. יום בשבוע = המופע הקרוב.\n3. durationMinutes — אם צוין משך השתמש בו וסמן durationMentioned=true; אחרת 60 ו-false.\n4. hourMentioned — true רק אם צוינה שעה במפורש.\n5. rawHour — השעה כפי שנאמרה (1–23) לפני המרות, או null.\n6. timeOfDayHint — \"morning\" / \"evening\" / null לפי רמזים (בבוקר/בערב/אחה״צ).\n7. אם אין תאריך/יום: error=\"לא מצאתי תאריך\", startsAt=null.\n8. אם אין שעה: startsAt ב-09:00, hourMentioned=false.\n9. אל תמציא פרטים שלא נרמזו. תמלול קולי עלול להיות מעוגל — נחש סבירות גבוהה לתאריך/שעה אם נאמרו בבירור.\n\nהודעה / תמלול:\n{{ $json.message.text }}\n"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "DZTNTvPM5Nc4xswY",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "4725e4b3-b0e8-4c1f-8fbb-73c76ed8d806",
      "name": "Validate & Defaults",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        -80
      ],
      "parameters": {
        "jsCode": "\nconst trigger = $('Telegram Trigger').first().json;\nconst msg = trigger.message || {};\nlet textForEvent = '';\ntry {\n  textForEvent = String($('Normalize Input').first().json.message.text || '').trim();\n} catch (e) {\n  textForEvent = String(msg.text || '').trim();\n}\nconst chatId = msg.chat?.id;\nconst messageId = msg.message_id;\n\nconst inputItem = $input.first();\nlet rawModel = inputItem.json.content?.parts?.[0]?.text\n  || inputItem.json.text\n  || inputItem.json.output\n  || inputItem.json;\nif (typeof rawModel === 'object' && rawModel !== null) {\n  if (rawModel.title !== undefined || rawModel.startsAt !== undefined || rawModel.error !== undefined) {\n    rawModel = JSON.stringify(rawModel);\n  } else if (rawModel.content?.parts?.[0]?.text) {\n    rawModel = rawModel.content.parts[0].text;\n  } else {\n    rawModel = JSON.stringify(rawModel);\n  }\n}\n\nlet clean = String(rawModel || '').replace(/```json|```/g, '').trim();\nlet ai;\ntry {\n  ai = JSON.parse(clean);\n  if (Array.isArray(ai)) ai = ai[0] || {};\n} catch (e) {\n  return [{ json: { ok: false, error: 'AI החזיר JSON לא תקין: ' + e.message, rawText: textForEvent, chatId, messageId, source: 'hybrid-voice' } }];\n}\n\nif (ai.error || !ai.startsAt) {\n  return [{ json: { ok: false, error: ai.error || 'לא מצאתי תאריך. שלחו טקסט או הקלטה עם יום ושעה', rawText: textForEvent, chatId, messageId, source: 'hybrid-voice', ai } }];\n}\n\nlet startsAt = new Date(ai.startsAt);\nif (Number.isNaN(startsAt.getTime())) {\n  return [{ json: { ok: false, error: 'תאריך לא תקין מה-AI', rawText: textForEvent, chatId, messageId, source: 'hybrid-voice', ai } }];\n}\n\nconst hourMentioned = Boolean(ai.hourMentioned);\nconst durationMentioned = Boolean(ai.durationMentioned);\nlet durationMinutes = Number(ai.durationMinutes);\nif (!Number.isFinite(durationMinutes) || durationMinutes <= 0) durationMinutes = 60;\nif (!durationMentioned) durationMinutes = 60;\n\nlet timeInferred = !hourMentioned;\nconst hint = (ai.timeOfDayHint || '').toLowerCase();\nconst forceMorning = hint === 'morning';\nconst forceEvening = ['evening', 'afternoon', 'night'].includes(hint);\nconst rawHour = ai.rawHour == null ? null : Number(ai.rawHour);\nlet hour = startsAt.getHours();\n\nif (hourMentioned && rawHour != null && Number.isFinite(rawHour)) {\n  let h = rawHour;\n  if (!forceMorning && (forceEvening || h <= 7) && h > 0 && h < 12) h += 12;\n  startsAt = new Date(startsAt.getFullYear(), startsAt.getMonth(), startsAt.getDate(), h, startsAt.getMinutes(), 0, 0);\n} else if (!hourMentioned) {\n  startsAt = new Date(startsAt.getFullYear(), startsAt.getMonth(), startsAt.getDate(), 9, 0, 0, 0);\n  timeInferred = true;\n} else if (!forceMorning && (forceEvening || hour <= 7) && hour > 0 && hour < 12) {\n  startsAt = new Date(startsAt.getTime() + 12 * 60 * 60 * 1000);\n}\n\nconst endsAt = new Date(startsAt.getTime() + durationMinutes * 60_000);\nlet title = String(ai.title || '').trim() || 'אירוע';\nif (title.length > 120) title = title.slice(0, 120);\n\nreturn [{\n  json: {\n    ok: true,\n    title,\n    startsAt: startsAt.toISOString(),\n    endsAt: endsAt.toISOString(),\n    durationMinutes,\n    timeInferred,\n    durationInferred: !durationMentioned,\n    confidence: ai.confidence ?? null,\n    rawText: textForEvent,\n    chatId,\n    messageId,\n    source: 'hybrid-voice',\n    fromVoice: Boolean(msg.voice || msg.audio),\n    ai,\n  },\n}];\n"
      }
    },
